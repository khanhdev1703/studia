generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  email    String @unique
  password String

  role Role @default(STUDENT)

  studentCode String? @unique

  courses          Course[]
  enrollments      Enrollment[]
  lessonProgresses LessonProgress[]

  // Soft delete
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isDelete])
  @@index([role, isDelete])
}

model Course {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  teacherId String @db.ObjectId
  teacher   User   @relation(fields: [teacherId], references: [id])

  title       String
  description String?
  thumbnail   String?

  // Giá khóa học, đơn vị: nghìn đồng
  // 0 = miễn phí
  // 299 = 299.000 VNĐ
  // 599 = 599.000 VNĐ
  // 1200 = 1.200.000 VNĐ
  price Int @default(0)

  // Thời hạn khóa học, đơn vị: tháng
  // Ví dụ: 1, 3, 6, 12
  durationMonths Int @default(6)

  // true = mở
  // false = đóng
  status Boolean @default(true)

  lessons     Lesson[]
  enrollments Enrollment[]

  // Soft delete
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([isDelete])
  @@index([teacherId, isDelete])
}

model Lesson {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  title       String
  description String?

  // URL hoặc path của video
  video String?

  // Thời lượng video, đơn vị: giây
  duration Int?

  // Thứ tự bài học trong khóa học
  order Int

  // true  = miễn phí
  // false = cần tham gia khóa học
  isFree Boolean @default(false)

  documents  LessonDocument[]
  progresses LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([courseId, order])
}

model LessonDocument {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  name     String
  url      String
  mimeType String
  size     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

model Enrollment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id])

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  enrolledAt DateTime @default(now())
  expiresAt  DateTime

  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([expiresAt])
}

model LessonProgress {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id])

  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  // null = chưa hoàn thành
  // có giá trị = đã hoàn thành
  completedAt DateTime?

  // Lần cuối học sinh truy cập bài học
  lastAccessedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}
